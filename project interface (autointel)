(function(){
  const c=document.getElementById("bg-canvas"),ctx=c.getContext("2d");
  let W,H,pts=[];
  function resize(){W=c.width=c.offsetWidth;H=c.height=c.offsetHeight;}
  resize();window.addEventListener("resize",resize);
  for(let i=0;i<50;i++)pts.push({x:Math.random()*100,y:Math.random()*100,vx:(Math.random()-.5)*.008,vy:(Math.random()-.5)*.008,r:Math.random()*1.4+.3,col:Math.random()<.5?'0,212,255':'255,170,0'});
  function draw(){
    ctx.clearRect(0,0,W,H);
    const g=ctx.createRadialGradient(W*.18,H*.5,0,W*.18,H*.5,W*.4);
    g.addColorStop(0,"rgba(0,212,255,.025)");g.addColorStop(1,"transparent");
    ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
    for(let i=0;i<pts.length;i++)for(let j=i+1;j<pts.length;j++){
      const a=pts[i],b=pts[j],dx=(a.x-b.x)*W/100,dy=(a.y-b.y)*H/100,d=Math.sqrt(dx*dx+dy*dy);
      if(d<90){ctx.beginPath();ctx.moveTo(a.x*W/100,a.y*H/100);ctx.lineTo(b.x*W/100,b.y*H/100);
        ctx.strokeStyle=`rgba(0,212,255,${.025*(1-d/90)})`;ctx.lineWidth=.4;ctx.stroke();}
    }
    pts.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>100)p.vx*=-1;if(p.y<0||p.y>100)p.vy*=-1;
      ctx.beginPath();ctx.arc(p.x*W/100,p.y*H/100,p.r,0,Math.PI*2);ctx.fillStyle=`rgba(${p.col},.28)`;ctx.fill();});
    requestAnimationFrame(draw);
  }
  draw();
})();

/* ── AUTH ── */
const ACCOUNTS={};let curEmail="";
const stepDotMap={"0":0,"login-email":1,"login-pw":2,"signin-email":1,"signin-pw":2,"2":3};
function goStep(n){
  document.querySelectorAll(".auth-step").forEach(s=>s.classList.remove("on"));
  const el=document.getElementById("st-"+n)||document.getElementById("st"+n);
  if(el)el.classList.add("on");
  const ni=stepDotMap[String(n)]??0;
  ["d0","d1","d2"].forEach((id,i)=>{
    const d=document.getElementById(id);d.classList.remove("active","done");
    if(i<ni)d.classList.add("done");if(i===ni)d.classList.add("active");
  });
}
function doLoginDirect(){
  const em=document.getElementById("f-login-email").value.trim().toLowerCase();
  const pw=document.getElementById("f-lpw").value;
  const eE=document.getElementById("err-login-email"),eP=document.getElementById("err-login-pw");
  eE.classList.remove("on");eP.classList.remove("on");
  if(!em||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em)){eE.textContent="Enter a valid email address.";eE.classList.add("on");return;}
  if(!pw){eP.textContent="Enter your password.";eP.classList.add("on");return;}
  if(!ACCOUNTS[em]){eE.textContent="No account found. Sign up instead.";eE.classList.add("on");return;}
  if(ACCOUNTS[em]!==pw){eP.textContent="Incorrect password.";eP.classList.add("on");document.getElementById("f-lpw").value="";return;}
  curEmail=em;
  const st2t=document.getElementById("st2-title");if(st2t)st2t.textContent="Authenticated.";
  const st2s=document.getElementById("st2-sub");if(st2s)st2s.textContent="Loading workspace…";
  goStep(2);setTimeout(()=>enterApp(false),950);
}
function checkSigninEmail(){
  const em=document.getElementById("f-signin-email").value.trim().toLowerCase();
  const err=document.getElementById("err-signin-email");
  if(!em||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em)){err.textContent="Enter a valid email.";err.classList.add("on");return;}
  if(ACCOUNTS[em]){err.textContent="Account already exists. Log in instead.";err.classList.add("on");return;}
  err.classList.remove("on");curEmail=em;
  document.getElementById("se-new").textContent=em;
  document.getElementById("err-signin-pw").classList.remove("on");
  document.getElementById("f-pw1").value="";document.getElementById("f-pw2").value="";
  document.getElementById("sbar-fill").style.width="0";
  goStep("signin-pw");
}
function doRegister(){
  const p1=document.getElementById("f-pw1").value,p2=document.getElementById("f-pw2").value;
  const err=document.getElementById("err-signin-pw");
  if(p1.length<8){err.textContent="Password must be at least 8 characters.";err.classList.add("on");return;}
  if(p1!==p2){err.textContent="Passwords do not match.";err.classList.add("on");return;}
  err.classList.remove("on");ACCOUNTS[curEmail]=p1;
  document.querySelectorAll(".auth-step").forEach(s=>s.classList.remove("on"));
  document.getElementById("st-account-exists").classList.add("on");
  ["d0","d1","d2"].forEach(id=>{const d=document.getElementById(id);d.classList.remove("active");d.classList.add("done");});
}
function pwStrength(inp){
  const v=inp.value;let s=0;
  if(v.length>=8)s++;if(v.length>=12)s++;if(/[A-Z]/.test(v))s++;if(/[0-9]/.test(v))s++;if(/[^a-zA-Z0-9]/.test(v))s++;
  const pct=[0,20,40,62,84,100][s];
  const col=s<=1?"#ff4466":s<=2?"#ffaa00":s<=3?"#ffcc44":s<=4?"#00c97a":"#00ff99";
  const f=document.getElementById("sbar-fill");f.style.width=pct+"%";f.style.background=col;
}
function enterApp(isNew){
  const land=document.getElementById("s-land"),app=document.getElementById("s-app");
  land.style.opacity="0";
  safeCharts(()=>{
    land.classList.remove("visible","in");app.classList.add("visible");
    requestAnimationFrame(()=>requestAnimationFrame(()=>app.classList.add("in")));
  },370);
  const name=curEmail.split("@")[0];
  const elUsr=document.getElementById("tb-usr");if(elUsr)elUsr.textContent=curEmail;
  const elAv=document.getElementById("tb-av");if(elAv)elAv.textContent=name.charAt(0).toUpperCase();
  navTo("home",document.getElementById("nb-home"),"Overview");
  initSidebar();
  toast(isNew?"Account created — welcome, "+name+"!":"Welcome back, "+name+".","ok");
}
function signOut(){
  const app=document.getElementById("s-app"),land=document.getElementById("s-land");
  app.classList.remove("in");
  safeCharts(()=>{
    app.classList.remove("visible");land.style.opacity="";
    land.classList.add("visible");requestAnimationFrame(()=>requestAnimationFrame(()=>land.classList.add("in")));
    goStep(0);curEmail="";
  },310);
  toast("Signed out.","amber");
}
function doRefresh(){
  showConfirm("Reset Session","All data will be cleared. This cannot be undone.",()=>{
    navTo("home",document.getElementById("nb-home"),"Overview");
    toast("Session reset.","amber");
  });
}

document.addEventListener("keydown",e=>{
  if(e.key!=="Enter")return;
  const a=document.querySelector(".auth-step.on");if(!a)return;
  const id=a.id;
  if(id==="st-login-email")doLoginDirect();
  else if(id==="st-signin-email")checkSigninEmail();
  else if(id==="st-signin-pw")doRegister();
});
window.addEventListener("load",()=>{
  const l=document.getElementById("s-land");l.classList.add("visible");
  requestAnimationFrame(()=>requestAnimationFrame(()=>l.classList.add("in")));
});

