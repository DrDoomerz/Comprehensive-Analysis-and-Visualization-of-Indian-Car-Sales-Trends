}
.pill-blue{color:var(--acc);border-color:var(--accbd);background:var(--accdim);}
.pill-pink{color:#ff4488;border-color:rgba(255,68,136,.3);background:rgba(255,68,136,.06);}
.pill-amber{color:var(--amb);border-color:var(--ambbd);background:var(--ambdim);}
.pill-green{color:var(--ok);border-color:var(--okbd);background:var(--okdim);}

/* ── BRAND ROW ── */
.h-brand-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;}
