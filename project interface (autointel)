/* ── DATASET VIEWER ── */
let dvBrand='mahindra',dvPage=1,dvPageSize=25,dvFiltered=[],dvSortCol=null,dvSortDir=1,dvInited=false;

function setDvTab(b){
  dvBrand=b;dvPage=1;dvSortCol=null;dvSortDir=1;
  ['mahindra','maruti','hyundai'].forEach(t=>document.getElementById('dvt-'+t).classList.toggle('on',t===b));
  document.getElementById('dv-search').value='';
  document.getElementById('dv-seg-filter').value='';
  document.getElementById('dv-fuel-filter').value='';
  initDataViewer();
}

function initDataViewer(){
  if(!CSV_DATA)return;
  const brandKey=dvBrand==='maruti'?'Maruti':dvBrand==='mahindra'?'Mahindra':'Hyundai';
  const ds=CSV_DATA[brandKey];
  const rows=ds.rows;
  const segs=[...new Set(rows.map(r=>r.Segment).filter(Boolean))].sort();
  const fuels=[...new Set(rows.map(r=>r.Fuel_Type).filter(Boolean))].sort();
  const segSel=document.getElementById('dv-seg-filter');
  const fuelSel=document.getElementById('dv-fuel-filter');
  const curSeg=segSel.value,curFuel=fuelSel.value;
  segSel.innerHTML='<option value="">All Segments</option>'+segs.map(s=>'<option value="'+s+'"'+(s===curSeg?' selected':'')+'>'+s+'</option>').join('');
  fuelSel.innerHTML='<option value="">All Fuel Types</option>'+fuels.map(f=>'<option value="'+f+'"'+(f===curFuel?' selected':'')+'>'+f+'</option>').join('');
  filterDvTable();
}

function filterDvTable(){
  const brandKey=dvBrand==='maruti'?'Maruti':dvBrand==='mahindra'?'Mahindra':'Hyundai';
  const ds=CSV_DATA[brandKey];
  const headers=ds.headers;
  let rows=[...ds.rows];
  const q=(document.getElementById('dv-search').value||'').toLowerCase();
  const seg=document.getElementById('dv-seg-filter').value;
  const fuel=document.getElementById('dv-fuel-filter').value;
  if(q)rows=rows.filter(r=>headers.some(h=>(r[h]||'').toString().toLowerCase().includes(q)));
  if(seg)rows=rows.filter(r=>r.Segment===seg);
  if(fuel)rows=rows.filter(r=>r.Fuel_Type===fuel);
  if(dvSortCol!=null){
    const col=headers[dvSortCol];
    rows.sort((a,b)=>{
      const av=isNaN(+a[col])?a[col]||'':+a[col];
      const bv=isNaN(+b[col])?b[col]||'':+b[col];
      return av>bv?dvSortDir:av<bv?-dvSortDir:0;
    });
  }
  dvFiltered=rows;dvPage=1;
  renderDvTable(headers);
}

function renderDvTable(headers){
  const brandKey=dvBrand==='maruti'?'Maruti':dvBrand==='mahindra'?'Mahindra':'Hyundai';
  const color=dvBrand==='maruti'?'#00d4ff':dvBrand==='mahindra'?'#ff4488':'#ffaa00';
  const total=dvFiltered.length;
  const pages=Math.max(1,Math.ceil(total/dvPageSize));
  if(dvPage>pages)dvPage=pages;
  const start=(dvPage-1)*dvPageSize;
  const pageRows=dvFiltered.slice(start,start+dvPageSize);
  document.getElementById('dv-meta').textContent=brandKey+' · '+total+' records · Page '+dvPage+' / '+pages;
  const thead=document.querySelector('#dv-table thead');
  const tbody=document.querySelector('#dv-table tbody');
  thead.innerHTML='<tr>'+headers.map((h,i)=>{
    const cls=dvSortCol===i?(dvSortDir===1?'sorted-asc':'sorted-desc'):'';
    return '<th class="'+cls+'" onclick="dvSort('+i+')">'+h.replace(/_/g,' ')+'</th>';
  }).join('')+'</tr>';
  tbody.innerHTML=pageRows.map(row=>{
    return '<tr>'+headers.map(h=>{
      const v=row[h];
      if(h==='Segment')return '<td><span class="dv-badge" style="background:'+color+'22;color:'+color+';border:1px solid '+color+'44">'+(v||'—')+'</span></td>';
      if(h==='Fuel_Type')return '<td><span class="dv-badge" style="background:rgba(255,170,0,.12);color:#ffaa00;border:1px solid rgba(255,170,0,.3)">'+(v||'—')+'</span></td>';
      if(h==='Safety_Rating_Stars'){const n=+(v||0);return '<td style="color:#ffcc44">'+(n?'★'.repeat(n):'—')+'</td>';}
      if(h==='Units_Sold'&&v)return '<td style="font-weight:600;color:var(--ink)">'+(+v).toLocaleString()+'</td>';
      if(h==='Revenue_Crores'&&v)return '<td style="color:var(--ok)">₹'+(+v).toFixed(0)+'Cr</td>';
      if(h==='Ex_Showroom_Price_Lakh'&&v)return '<td>₹'+(+v).toFixed(2)+'L</td>';
      if(h==='Annual_Service_Cost_INR'&&v)return '<td>₹'+(+v).toLocaleString()+'</td>';
      return '<td>'+(v||'—')+'</td>';
    }).join('')+'</tr>';
  }).join('');
  // pager
  const pager=document.getElementById('dv-pager');
  let pg='<button class="dv-page-btn" onclick="dvGoPage('+(dvPage-1)+')" '+(dvPage<=1?'disabled':'')+'>‹ Prev</button>';
  const range=5,half=2;
  let lo=Math.max(1,dvPage-half),hi=Math.min(pages,lo+range-1);
  if(hi-lo<range-1)lo=Math.max(1,hi-range+1);
  if(lo>1)pg+='<button class="dv-page-btn" onclick="dvGoPage(1)">1</button><span style="color:var(--ink4)">…</span>';
  for(let i=lo;i<=hi;i++)pg+='<button class="dv-page-btn '+(i===dvPage?'on':'')+'" onclick="dvGoPage('+i+')">'+i+'</button>';
  if(hi<pages)pg+='<span style="color:var(--ink4)">…</span><button class="dv-page-btn" onclick="dvGoPage('+pages+')">'+pages+'</button>';
  pg+='<button class="dv-page-btn" onclick="dvGoPage('+(dvPage+1)+')" '+(dvPage>=pages?'disabled':'')+'>Next ›</button>';
  pg+='<span style="margin-left:6px;color:var(--ink4)">Showing '+(start+1)+'–'+Math.min(start+dvPageSize,total)+' of '+total+'</span>';
  pager.innerHTML=pg;
}

function dvSort(i){
  if(dvSortCol===i)dvSortDir*=-1;else{dvSortCol=i;dvSortDir=1;}
  filterDvTable();
}
function dvGoPage(p){
  const pages=Math.ceil(dvFiltered.length/dvPageSize);
  if(p<1||p>pages)return;dvPage=p;
  const brandKey=dvBrand==='maruti'?'Maruti':dvBrand==='mahindra'?'Mahindra':'Hyundai';
  renderDvTable(CSV_DATA[brandKey].headers);
}
function exportDvCSV(){
  const brandKey=dvBrand==='maruti'?'Maruti':dvBrand==='mahindra'?'Mahindra':'Hyundai';
  const ds=CSV_DATA[brandKey];
  const headers=ds.headers;
  const rows=dvFiltered;
  const csv=[headers.join(','),...rows.map(r=>headers.map(h=>(r[h]||'').toString().replace(/,/g,';')).join(','))].join('\n');
  const a=document.createElement('a');a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv);
  a.download=brandKey+'_filtered.csv';a.click();
}

