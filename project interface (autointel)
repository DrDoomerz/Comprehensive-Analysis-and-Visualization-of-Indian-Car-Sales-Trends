  color:var(--ink4);padding:2px 7px;border:1px solid var(--br);border-radius:4px;}
.h-brand-sep{color:var(--br2);font-size:18px;}

/* ── TICKER ── */
.ticker-wrap{
  background:var(--s1);border-top:1px solid var(--br);border-bottom:1px solid var(--br);
  padding:10px 0;overflow:hidden;position:relative;margin-bottom:16px;
}
.ticker-wrap::before,.ticker-wrap::after{
  content:"";position:absolute;top:0;bottom:0;width:80px;z-index:2;pointer-events:none;
}
.ticker-wrap::before{left:0;background:linear-gradient(to right,var(--bg2),transparent);}
.ticker-wrap::after{right:0;background:linear-gradient(to left,var(--bg2),transparent);}
.ticker-label{
  position:absolute;left:16px;top:50%;transform:translateY(-50%);z-index:3;
