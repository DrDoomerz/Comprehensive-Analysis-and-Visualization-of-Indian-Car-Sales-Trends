const BC={Maruti:'#00d4ff',Mahindra:'#ff4488',Hyundai:'#ffaa00'};
const BRANDS=['Maruti','Mahindra','Hyundai'];
const MO=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const TT={backgroundColor:'#0f1a2a',borderColor:'#263d5e',borderWidth:1,titleColor:'#e8f0fb',bodyColor:'#4a6688',padding:10,cornerRadius:4};
const SC={x:{grid:{color:'rgba(255,255,255,.03)'},ticks:{color:'#4a6688',maxTicksLimit:10,font:{size:10}},title:{display:false,color:'#4a6688',font:{size:10,family:'JetBrains Mono'}}},y:{grid:{color:'rgba(255,255,255,.05)'},ticks:{color:'#4a6688',font:{size:10}},title:{display:false,color:'#4a6688',font:{size:10,family:'JetBrains Mono'}}}};

function fmt(n){if(n==null||isNaN(n))return"—";return n>=1e6?(n/1e6).toFixed(1)+"M":n>=1e3?(n/1e3).toFixed(0)+"K":String(Math.round(n));}
function avg(a){return a.reduce((s,v)=>s+v,0)/a.length;}
function allHistM(){const s=new Set();BRANDS.forEach(b=>DATA.historical[b].months.forEach(m=>s.add(m)));return[...s].sort();}
function mLabel(m){const d=new Date(m+"-01");return MO[d.getMonth()]+" '"+d.getFullYear().toString().slice(2);}
function align(brand,months,key){const mp={};DATA.historical[brand].months.forEach((m,i)=>mp[m]=DATA.historical[brand][key][i]);return months.map(m=>mp[m]??null);}

const baseOpts=(extra={})=>({
  responsive:true,maintainAspectRatio:false,
  plugins:{legend:{display:true,labels:{color:'#4a6688',usePointStyle:true,pointStyleWidth:8,font:{size:10}}},tooltip:TT,...(extra.plugins||{})},
  scales:{...SC,...(extra.scales||{})}
});

/* ── EXPLORER STATE ── */
let curMode='present', curAnalysis='individual', curBrand='Maruti';
let explorerCharts=[];

function setMode(m){
  curMode=m;
  ['past','present','future'].forEach(t=>{
    document.getElementById('mt-'+t).classList.toggle('active',t===m);
  });
  showRunPrompt();
}

function setAnalysis(a){
  curAnalysis=a;
  ['individual','comparison'].forEach(t=>{
    document.getElementById('at-'+t).classList.toggle('active',t===a);
  });
  document.getElementById('brand-filter-wrap').style.display=(a==='individual'?'block':'none');
  showRunPrompt();
}

function setBrand(b){
  curBrand=b;
  document.getElementById('bf-maruti').classList.toggle('on',b==='Maruti');
  document.getElementById('bf-mahindra').classList.toggle('on',b==='Mahindra');
  document.getElementById('bf-hyundai').classList.toggle('on',b==='Hyundai');
  showRunPrompt();
}

function showRunPrompt(){
  destroyExplorerCharts();
  const el=document.getElementById('explore-results');
  el.innerHTML=`<div class="run-prompt">
    <div class="run-prompt-ico">▶</div>
    <div class="run-prompt-title">Ready to Analyse</div>
    <div class="run-prompt-sub">Selections complete — click below to generate the charts</div>
    <button class="btn-run-analysis" onclick="renderExplorer()">▶ Run Analysis</button>
  </div>`;
}

function destroyExplorerCharts(){
  explorerCharts.forEach(c=>{try{c.destroy();}catch(e){}});
  explorerCharts=[];
}

function renderExplorer(){
  destroyExplorerCharts();
  const el=document.getElementById('explore-results');
  el.innerHTML='<div style="padding:28px;text-align:center;font-family:var(--font-mono);font-size:10px;color:var(--ink4);">Rendering charts…</div>';
  // Use rAF to ensure DOM is ready, wrapped in try/catch to prevent uncaught errors
  requestAnimationFrame(()=>{
    try{
      if(curAnalysis==='individual') renderIndividual(el);
      else renderComparison(el);
    }catch(e){
      el.innerHTML='<div style="padding:28px;background:var(--errdim);border:1px solid var(--errbd);border-radius:10px;font-family:var(--font-mono);font-size:11px;color:var(--err);">Render error: '+e.message+'</div>';
      console.error('Explorer render error:',e);
    }
  });
}

function renderIndividual(el){
  const b=curBrand;
  const color=BC[b];
  const colorDim=color+'22';

  if(curMode==='past'){
    const hMonths=DATA.historical[b].months;
    const hUnits=DATA.historical[b].units;
    const hRev=DATA.historical[b].revenue;
    const hPrice=DATA.historical[b].avg_price;
    const hRating=DATA.historical[b].avg_rating;
    const avgUnits=Math.round(avg(hUnits));
    const avgRev=avg(hRev).toFixed(0);
    const avgPrice=avg(hPrice).toFixed(2);
    const avgRating=avg(hRating).toFixed(2);
    const labels=hMonths.map(mLabel);
    el.innerHTML=`
      <div class="kpi-row">
        <div class="kc kc-b"><div class="kc-lbl">${b} · Avg Monthly Sales</div><div class="kc-val" style="color:${color}">${fmt(avgUnits)}</div><div class="kc-sub">units sold</div></div>
        <div class="kc kc-a"><div class="kc-lbl">Avg Revenue</div><div class="kc-val" style="color:var(--amb)">₹${fmt(+avgRev)}Cr</div><div class="kc-sub">per month</div></div>
        <div class="kc kc-g"><div class="kc-lbl">Avg Customer Rating</div><div class="kc-val" style="color:var(--ok)">${avgRating}★</div><div class="kc-sub">out of 5.0</div></div>
      </div>
      <div class="cc cfull"><h3>${b} — Monthly Sales (Historical)</h3><div class="cc-sub">2020–2024 actual units sold</div><div class="cw" style="height:240px"><canvas id="ex-c1"></canvas></div></div>
      <div class="cgrid">
