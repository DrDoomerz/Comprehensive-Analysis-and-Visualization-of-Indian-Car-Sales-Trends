/* ── Nav ── */
function navTo(id,btn,label){
  document.querySelectorAll(".panel").forEach(p=>p.classList.remove("on"));
  document.getElementById("p-"+id).classList.add("on");
  document.querySelectorAll(".nav-btn").forEach(b=>b.classList.remove("on"));
  if(btn)btn.classList.add("on");
  if(label){const ts=document.getElementById("tb-sec");if(ts)ts.textContent=label;}
  if(id==="explore"){
    // Reset state so results don't show until user completes all steps
    destroyExplorerCharts();
    document.getElementById('explore-results').innerHTML='';
    showRunPrompt();
  }
  if(id==="data") initDataViewer();
}

