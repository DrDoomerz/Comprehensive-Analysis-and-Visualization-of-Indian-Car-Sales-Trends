function safeCharts(fn){
  // Wait two animation frames so innerHTML has rendered to DOM
  requestAnimationFrame(()=>requestAnimationFrame(()=>{
    try{ fn(); }
    catch(e){ console.error('Chart render error:',e); }
  }));
}

function sv(id,val,pre,suf){
  const el=document.getElementById("lv-"+id);
  if(el)el.textContent=pre+val+suf;
}

