        <div class="cc"><h3>Avg Price (₹ Lakh)</h3><div class="cc-sub">Price evolution over time</div><div class="cw" style="height:200px"><canvas id="ex-c3"></canvas></div></div>
        <div class="cc"><h3>Customer Rating</h3><div class="cc-sub">Monthly satisfaction score</div><div class="cw" style="height:200px"><canvas id="ex-c4"></canvas></div></div>
