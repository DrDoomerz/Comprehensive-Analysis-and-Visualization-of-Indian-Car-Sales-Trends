const BS={Maruti:{base:6700,pF:-310,mF:175,rF:1200,sF:-0.08,saF:390,gr:0.018},Mahindra:{base:7166,pF:-170,mF:200,rF:1480,sF:-0.055,saF:590,gr:0.075},Hyundai:{base:7560,pF:-190,mF:185,rF:1340,sF:-0.065,saF:490,gr:0.055}};
const SM={Hatchback:1.13,SUV:1.03,Sedan:0.85,MPV:0.76};
const FM={Petrol:1.03,"Petrol/CNG":0.92,"Petrol/Strong Hybrid":0.94,Diesel:1.00,Electric:0.82};
const TM={Manual:1.05,Automatic:0.93,"Manual/AMT":1.0};
const SS=[0.97,0.98,1.04,1.03,1.02,1.01,0.99,1.00,1.01,1.02,1.03,0.98];
const BD={Maruti:{price:8,mileage:22,rating:4.2,service:10700,safety:4},Mahindra:{price:15,mileage:17,rating:4.1,service:9100,safety:4},Hyundai:{price:15,mileage:18,rating:4.1,service:8000,safety:4}};

function onBrandChange(){
  const b=document.getElementById("i-brand").value,d=BD[b];
  [["price",d.price,"₹","L"],["mileage",d.mileage,"","kmpl"],["rating",d.rating,"","★"],["service",d.service,"₹",""],["safety",d.safety,"","★"]].forEach(([id,val,pre,suf])=>{
    document.getElementById("i-"+id).value=val;
    document.getElementById("lv-"+id).textContent=pre+val+suf;
  });
  toast("Defaults set for "+b,"ok");
}

function calcPred(brand,price,mileage,rating,service,safety,seg,fuel,trans,year,month,noise){
  const s=BS[brand];
  let base=s.base+(price-10)*s.pF+(mileage-20)*s.mF+(rating-4)*s.rF+(service-10000)*s.sF+(safety-3)*s.saF;
  if(noise)base=base*(1+noise*(Math.random()-.5));
  return Math.max(500,Math.round(base*SM[seg]*FM[fuel]*TM[trans]*Math.pow(1+s.gr,year-2024)*SS[month-1]));
}

let plc=null,pbc=null,pfc=null;
function runPredict(){
  const brand=document.getElementById("i-brand").value;
  const seg=document.getElementById("i-seg").value;
  const fuel=document.getElementById("i-fuel").value;
  const trans=document.getElementById("i-trans").value;
  const price=+document.getElementById("i-price").value;
  const mileage=+document.getElementById("i-mileage").value;
  const rating=+document.getElementById("i-rating").value;
  const service=+document.getElementById("i-service").value;
  const safety=+document.getElementById("i-safety").value;
  const year=+document.getElementById("i-year").value;
  const month=+document.getElementById("i-month").value;

  const rf=calcPred(brand,price,mileage,rating,service,safety,seg,fuel,trans,year,month,0);
  const knn=calcPred(brand,price,mileage,rating,service,safety,seg,fuel,trans,year,month,0.10);
  const ridge=calcPred(brand,price,mileage,rating,service,safety,seg,fuel,trans,year,month,0);
  const ens=Math.round((rf+knn+ridge)/3);

  document.getElementById("r-ens").textContent=fmt(ens);

  const base6=Math.round(avg(DATA.historical[brand].units.slice(-6)));
  const diff=ens-base6;const pct=((diff/base6)*100).toFixed(1);
  document.getElementById("r-insight").innerHTML=`<strong>${brand}</strong> averaged ${fmt(base6)}/mo recently. ${year} estimate is <strong>${diff>=0?"+":""}${pct}%</strong> vs baseline. ${price<8?"Budget positioning maximises volume.":price>20?"Premium pricing limits volume.":"Mid-range positioning."}`;
  document.getElementById("pred-ph").style.display="none";
  document.getElementById("pred-result").classList.add("on");

  if(plc)plc.destroy();
  const hM=DATA.historical[brand].months,hU=DATA.historical[brand].units;
  const fM=DATA.forecast[brand].months,fU=DATA.forecast[brand].units;
  const allM=[...hM,...fM];
  const pk=year+"-"+String(month).padStart(2,"0");
  const dotD=allM.map(m=>m===pk?ens:null);
  const lb=allM.map(m=>{const d=new Date(m+"-01");return d.getFullYear()+"/"+(d.getMonth()+1).toString().padStart(2,"0");});
  plc=new Chart(document.getElementById("c-pred-line"),{type:"line",data:{labels:lb,datasets:[
    {label:"Historical",data:[...hU,...fM.map(()=>null)],borderColor:BC[brand],backgroundColor:"transparent",pointRadius:1.5,borderWidth:2.5,tension:.4},
    {label:"Forecast",data:[...hM.map(()=>null),...fU],borderColor:BC[brand],backgroundColor:"transparent",borderDash:[5,4],pointRadius:0,borderWidth:2,tension:.4},
    {label:"Your Input",data:dotD,borderColor:"#e8f0fb",backgroundColor:"#e8f0fb",pointRadius:9,showLine:false},
  ]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:true,labels:{color:"#4a6688",usePointStyle:true,pointStyleWidth:8,font:{size:10}}},tooltip:TT},scales:{x:{...SC.x,title:{display:true,text:"Month / Year",color:"#4a6688",font:{size:10,family:"JetBrains Mono"}}},y:{...SC.y,title:{display:true,text:"Units Sold",color:"#4a6688",font:{size:10,family:"JetBrains Mono"}}}}}});

  // Model comparison chart removed (single ensemble output used)

  if(pfc)pfc.destroy();
  const s=BS[brand];
  const contrib=[
    {f:"Price",v:Math.abs((price-10)*s.pF)},{f:"Mileage",v:Math.abs((mileage-20)*s.mF)},
    {f:"Rating",v:Math.abs((rating-4)*s.rF)},{f:"Service Cost",v:Math.abs((service-10000)*s.sF)},
    {f:"Safety",v:Math.abs((safety-3)*s.saF)},{f:"Segment",v:Math.abs((SM[seg]-1)*s.base)},
    {f:"Yr Growth",v:Math.abs((Math.pow(1+s.gr,year-2024)-1)*s.base)},{f:"Seasonality",v:Math.abs((SS[month-1]-1)*s.base)},
  ].sort((a,b)=>b.v-a.v);
  pfc=new Chart(document.getElementById("c-feat"),{type:"bar",data:{labels:contrib.map(c=>c.f),datasets:[{data:contrib.map(c=>Math.round(c.v)),backgroundColor:BC[brand]+'99',borderColor:BC[brand],borderWidth:1,borderRadius:4}]},options:{indexAxis:"y",responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:TT},scales:{x:{...SC.x,title:{display:true,text:"Impact on Units Sold",color:"#4a6688",font:{size:10,family:"JetBrains Mono"}}},y:{...SC.y,ticks:{...SC.y.ticks,font:{size:10}},title:{display:true,text:"Feature",color:"#4a6688",font:{size:10,family:"JetBrains Mono"}}}}}});

  toast("Prediction complete — "+fmt(ens)+" units (ensemble)","ok");
}

